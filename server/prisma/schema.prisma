datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String                @id @default(uuid())
  email                String                @unique
  name                 String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  goals                Goal[]
  tasks                Task[]
  timeBlocks           TimeBlock[]
  memories             Memory[]
  preferences          UserPreference[]
  conversationMessages ConversationMessage[]
  reminders            Reminder[]
  accountabilityLogs   AccountabilityLog[]
  plans                Plan[]
  aiExecutions         AiExecution[]
  aiToolApprovals      AiToolApproval[]
  researchItems        ResearchItem[]
  domainEvents         DomainEvent[]
  backgroundJobs       BackgroundJob[]
  integrationAccounts  IntegrationAccount[]
  notificationPrefs    NotificationPreference[]
  notificationDelivs   NotificationDelivery[]
  voiceSessions        VoiceSession[]

  @@map("users")
}

model Goal {
  id                 String              @id @default(uuid())
  userId             String
  parentGoalId       String?
  title              String
  description        String?
  category           String
  timeframe          String              @default("YEARLY")
  targetYear         Int?
  targetDate         DateTime?
  status             String              @default("ACTIVE")
  progress           Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentGoal         Goal?               @relation("GoalHierarchy", fields: [parentGoalId], references: [id], onDelete: SetNull)
  subGoals           Goal[]              @relation("GoalHierarchy")
  milestones         Milestone[]
  tasks              Task[]
  timeBlocks         TimeBlock[]
  reminders          Reminder[]
  accountabilityLogs AccountabilityLog[]
  plans              Plan[]
  researchItems      ResearchItem[]

  @@map("goals")
}

model Milestone {
  id          String    @id @default(uuid())
  goalId      String
  title       String
  description String?
  order       Int       @default(0)
  targetDate  DateTime?
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@map("milestones")
}

model Task {
  id                 String              @id @default(uuid())
  userId             String
  goalId             String?
  milestoneId        String?
  parentTaskId       String?
  title              String
  description        String?
  priority           String              @default("MEDIUM")
  status             String              @default("TODO")
  dueDate            DateTime?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal               Goal?               @relation(fields: [goalId], references: [id], onDelete: SetNull)
  milestone          Milestone?          @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  parentTask         Task?               @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks           Task[]              @relation("TaskSubtasks")
  timeBlocks         TimeBlock[]
  reminders          Reminder[]
  accountabilityLogs AccountabilityLog[]

  @@map("tasks")
}

model TimeBlock {
  id             String   @id @default(uuid())
  userId         String
  taskId         String?
  goalId         String?
  title          String
  description    String?
  startTime      DateTime
  endTime        DateTime
  category       String   @default("WORK")
  status         String   @default("SCHEDULED")
  isRecurring    Boolean  @default(false)
  recurrenceRule String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task           Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  goal           Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@map("time_blocks")
}

model Reminder {
  id          String    @id @default(uuid())
  userId      String
  taskId      String?
  goalId      String?
  title       String
  message     String?
  remindAt    DateTime
  status      String    @default("PENDING")
  channel     String    @default("IN_APP")
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  goal        Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@map("reminders")
}

model AccountabilityLog {
  id         String    @id @default(uuid())
  userId     String
  taskId     String?
  goalId     String?
  type       String
  severity   String    @default("MEDIUM")
  status     String    @default("OPEN")
  notes      String?
  metadata   Json?
  detectedAt DateTime  @default(now())
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  goal       Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@map("accountability_logs")
}

model Memory {
  id             String                        @id @default(uuid())
  userId         String
  title          String?
  content        String
  category       String                        @default("GENERAL")
  memoryType     String                        @default("SEMANTIC")
  sourceType     String                        @default("MANUAL")
  sourceId       String?
  tags           String[]                      @default([])
  importance     Int                           @default(1)
  confidence     Float                         @default(1.0)
  expiresAt      DateTime?
  supersededById String?
  embedding      Unsupported("vector(768)")?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  user           User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  supersededBy   Memory?                       @relation("MemorySupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     Memory[]                      @relation("MemorySupersession")

  @@index([userId, memoryType])
  @@index([userId, expiresAt])
  @@index([supersededById])
  @@map("memories")
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     String
  category  String   @default("GENERAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("user_preferences")
}

model ConversationMessage {
  id        String   @id @default(uuid())
  userId    String
  sessionId String   @default("default")
  role      String
  content   String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("conversation_messages")
}

model Plan {
  id             String    @id @default(uuid())
  userId         String
  goalId         String?
  title          String
  summary        String
  status         String    @default("DRAFT")
  milestonesData Json
  tasksData      Json
  provider       String?
  model          String?
  appliedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal           Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@map("plans")
}

model AiExecution {
  id                  String           @id @default(uuid())
  userId              String
  parentExecutionId   String?
  sessionId           String           @default("default")
  threadId            String           @default(uuid())
  agentRole           String           @default("MAIN_ORCHESTRATOR")
  triggerType         String           @default("REQUEST")
  idempotencyKey      String?          @unique
  prompt              String
  status              String           @default("RUNNING")
  provider            String?
  model               String?
  tokenBudget         Int?
  tokensUsed          Int              @default(0)
  langsmithTraceId    String?
  checkpointNamespace String?
  timeoutAt           DateTime?
  responseText        String?
  errorMessage        String?
  attempts            Int              @default(1)
  stepsData           Json?
  startedAt           DateTime         @default(now())
  completedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentExecution     AiExecution?     @relation("ExecutionSubagents", fields: [parentExecutionId], references: [id], onDelete: SetNull)
  subagentExecutions  AiExecution[]    @relation("ExecutionSubagents")
  approvals           AiToolApproval[]
  backgroundJobs      BackgroundJob[]

  @@index([threadId])
  @@index([parentExecutionId])
  @@map("ai_executions")
}

model AiToolApproval {
  id             String      @id @default(uuid())
  executionId    String
  userId         String
  toolName       String
  toolArgs       Json
  riskLevel      String      @default("INTERNAL_WRITE")
  agentRole      String      @default("MAIN_ORCHESTRATOR")
  idempotencyKey String?     @unique
  status         String      @default("PENDING")
  decisionReason String?
  resultData     Json?
  errorMessage   String?
  expiresAt      DateTime?
  decidedAt      DateTime?
  executedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  execution      AiExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([executionId, status])
  @@index([expiresAt])
  @@map("ai_tool_approvals")
}

model ResearchItem {
  id          String   @id @default(uuid())
  userId      String
  goalId      String?
  query       String
  title       String
  summary     String
  keyFindings Json
  sources     Json
  status      String   @default("COMPLETED")
  provider    String?
  model       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@map("research_items")
}

model DomainEvent {
  id             String          @id @default(uuid())
  userId         String
  eventType      String
  source         String
  payload        Json
  status         String          @default("PENDING")
  idempotencyKey String?         @unique
  attempts       Int             @default(0)
  maxAttempts    Int             @default(3)
  processedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  backgroundJobs BackgroundJob[]

  @@index([userId, status])
  @@index([eventType, status])
  @@map("domain_events")
}

model BackgroundJob {
  id             String       @id @default(uuid())
  userId         String
  executionId    String?
  domainEventId  String?
  jobType        String
  externalJobId  String?
  idempotencyKey String?      @unique
  payload        Json?
  resultData     Json?
  status         String       @default("QUEUED")
  attempts       Int          @default(0)
  maxAttempts    Int          @default(3)
  scheduledFor   DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  lastError      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  execution      AiExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)
  domainEvent    DomainEvent? @relation(fields: [domainEventId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, scheduledFor])
  @@index([jobType, status])
  @@map("background_jobs")
}

model IntegrationAccount {
  id                   String    @id @default(uuid())
  userId               String
  provider             String
  externalAccountId    String?
  encryptedCredentials String
  scopes               String[]  @default([])
  status               String    @default("ACTIVE")
  lastSyncedAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([provider, status])
  @@map("integration_accounts")
}

model NotificationPreference {
  id          String   @id @default(uuid())
  userId      String
  channel     String
  enabled     Boolean  @default(true)
  quietStart  String?
  quietEnd    String?
  frequencyCap Int     @default(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@map("notification_preferences")
}

model NotificationDelivery {
  id                String    @id @default(uuid())
  userId            String
  channel           String
  subject           String?
  body              String
  providerMessageId String?
  status            String    @default("PENDING")
  attempts          Int       @default(0)
  maxAttempts       Int       @default(3)
  lastError         String?
  metadata          Json?
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([channel, status])
  @@map("notification_deliveries")
}

model VoiceSession {
  id              String    @id @default(uuid())
  userId          String
  executionId     String?
  languageCode    String    @default("en")
  asrTranscript   String?
  translatedText  String?
  ttsAudioKey     String?
  duration        Int?
  callMetadata    Json?
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("voice_sessions")
}
